FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (include bash for interactive debugging)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    gcc \
    bash \
    libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


# Copy requirements from project root
COPY requirements-dashboard.txt ./requirements-dashboard.txt
RUN pip install --no-cache-dir -r requirements-dashboard.txt

# Ensure Python outputs are not buffered (helps with logging)
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/dashboard:/app/dashboard/src:/app/engine_module/src:/app/market_data/src:/app/risk_module/src:/app/news_module/src:/app/user_module/src:/app/genai_module/src

# Copy application code
COPY . .


# Create non-root user and set permissions
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app

# Switch to non-root user
USER app

# Ensure working directory is set for the app user
WORKDIR /app

EXPOSE 8001

# Default command (use uvicorn CLI for better logging)
CMD ["uvicorn", "dashboard.app:app", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]